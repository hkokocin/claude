{
  "permissions": {
    "allow": [
      "Read(~/docs/**)",
      "Read(~/.claude/shared/**)",
      "Read(~/projects/testing/curl/**)",
      "Bash(cat:*)",
      "Bash(fd:*)",
      "Bash(docker compose:*)",
      "Bash(docker images:*)",
      "Bash(docker inspect:*)",
      "Bash(docker logs:*)",
      "Bash(docker network ls:*)",
      "Bash(docker ps:*)",
      "Bash(docker stats:*)",
      "Bash(docker volume ls:*)",
      "Bash(rg:*)",
      "Bash(gh api:*)",
      "Bash(gh issue:*)",
      "Bash(gh pr:*)",
      "Bash(gh release:*)",
      "Bash(gh repo view:*)",
      "Bash(gh run:*)",
      "Bash(gh workflow:*)",
      "Bash(git branch:*)",
      "Bash(git diff:*)",
      "Bash(git fetch:*)",
      "Bash(git log:*)",
      "Bash(pip index:*)",
      "Bash(git merge:*)",
      "Bash(git rev-parse:*)",
      "Bash(git show:*)",
      "Bash(poetry run:*)",
      "Bash(poetry add:*)",
      "Bash(poetry check:*)",
      "Bash(poetry env:*)",
      "Bash(poetry install:*)",
      "Bash(poetry lock:*)",
      "Bash(poetry show:*)",
      "Bash(poetry version:*)",
      "Bash(terraform fmt:*)",
      "Bash(terraform init:*)",
      "Bash(terraform output:*)",
      "Bash(terraform plan:*)",
      "Bash(terraform providers:*)",
      "Bash(terraform show:*)",
      "Bash(terraform state list:*)",
      "Bash(terraform validate:*)",
      "Bash(set -a && source .env && poetry run:*)",
      "mcp__plugin_asana_asana__*"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Bash(terraform apply:*)",
      "Bash(gh pr close:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh issue close:*)",
      "Bash(gh issue delete:*)",
      "Bash(gh repo delete:*)"
    ],
    "additionalDirectories": [
      "~/docs",
      "~/.claude/shared",
      "~/projects/testing/curl"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'REMINDER: Follow TDD.'"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/opt/homebrew/Cellar/claude-notify/1.1.0/lib/claude-notify/core/notifier.sh notification"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/opt/homebrew/Cellar/claude-notify/1.1.0/lib/claude-notify/core/notifier.sh stop"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "padding": 0
  },
  "enabledPlugins": {
    "asana@claude-plugins-official": true,
    "sentry@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "terraform-code-generation@hashicorp": false,
    "terraform-module-generation@hashicorp": false
  },
  "alwaysThinkingEnabled": true,
  "autoApproveCommands": false,
  "effortLevel": "high"
}
